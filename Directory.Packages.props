<Project>

    <!-- Global NuGet configuration -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>

    <!-- Revit dependencies -->
    <ItemGroup>
        <PackageVersion Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*-*" Condition="$(RevitVersion) != ''"/>

        <PackageVersion Include="Nice3point.TUnit.Revit" Version="2021.1.1" Condition="$(RevitVersion) == '2021'"/>
        <PackageVersion Include="Nice3point.TUnit.Revit" Version="2022.1.1" Condition="$(RevitVersion) == '2022'"/>
        <PackageVersion Include="Nice3point.TUnit.Revit" Version="2023.1.1" Condition="$(RevitVersion) == '2023'"/>
        <PackageVersion Include="Nice3point.TUnit.Revit" Version="2024.1.1" Condition="$(RevitVersion) == '2024'"/>
        <PackageVersion Include="Nice3point.TUnit.Revit" Version="2025.1.1" Condition="$(RevitVersion) == '2025'"/>
        <PackageVersion Include="Nice3point.TUnit.Revit" Version="2026.1.1" Condition="$(RevitVersion) == '2026'"/>
        <PackageVersion Include="Nice3point.TUnit.Revit" Version="2027.0.1" Condition="$(RevitVersion) == '2027'"/>
    </ItemGroup>

    <!-- Core dependencies -->
    <ItemGroup>
        <!-- Logging -->
        <PackageVersion Include="Microsoft.Extensions.Logging.Configuration" Version="8.0.0"/>

        <!-- Build automation -->
        <PackageVersion Include="Sourcy.DotNet" Version="1.1.1"/>
        <PackageVersion Include="ModularPipelines" Version="3.2.8"/>
        <PackageVersion Include="ModularPipelines.Git" Version="3.2.8"/>
        <PackageVersion Include="ModularPipelines.GitHub" Version="3.2.8"/>
        <PackageVersion Include="ModularPipelines.DotNet" Version="3.2.8"/>

        <!-- Testing -->
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11"/>
        <PackageVersion Include="TUnit" Version="1.65.68"/>
        <PackageVersion Include="Shouldly" Version="4.3.0"/>

        <!-- Development tools -->
        <PackageVersion Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52"/>
    </ItemGroup>

    <!-- Development dependencies -->
    <ItemGroup>
        <GlobalPackageReference Include="Polyfill" Version="11.2.0"/>
        <GlobalPackageReference Include="JetBrains.Annotations.Sources" Version="2026.2.0"/>
    </ItemGroup>

</Project>
